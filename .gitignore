# Certificados, claves privadas y credenciales de Release 2 (nunca en Git).
certs/
*.pem
*.key
*.cred

# Dependencias de Node.js (WM_Registry, WM_Front): se instalan con npm ci.
node_modules/

# Metadatos del sistema.
.DS_Store
