# Archivos generados por Python y entornos locales.
__pycache__/
*.py[cod]
.venv/
venv/

# Configuración privada y datos de ejecución.
.env
.env.*
!.env.example
*.log

# Datos persistentes y ficheros auxiliares de SQLite.
data/
*.db
*.db-*
*.sqlite
